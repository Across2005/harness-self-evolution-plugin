# Normalize line endings so the published repo is identical on every platform.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary

# Windows shell scripts must keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never let Git treat these as diffable text
package-lock.json text merge=binary linguist-generated=true
dist/** linguist-generated=true export-ignore
