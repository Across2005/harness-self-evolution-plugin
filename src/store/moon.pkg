import {
  "Across2005/harness-self-evolution/types",
  "Across2005/harness-self-evolution/util",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/async",
} for "wbtest"

options(
  // 本包用例大量读写真实文件（JSONL 追加 / 缓存原子替换 / 日志）。
  // Phase 4 实测：文件系统密集型用例在默认并行度下会触发 async I/O
  // worker 的 `guard handle.write is Idle` panic，一个用例崩溃会带死
  // 整个测试进程，只留下一串「active at exit」的名字而无法定位。
  "max-concurrent-tests": 1,
)

// 关闭 implicit_impl_as_method（moonc v0.10.14 起新增的 deprecation）：本包的
// `derive(Eq, Debug, ToJson, @json.FromJson)`（ExecLogRecord / CacheFile 等）会
// 把 trait 方法隐式提升为点号方法，编译器已将「隐式提升」标记 deprecated。
// 与 types 包同一立场：不依赖该提升，序列化统一走 trait 调用形式；仅关闭这一
// 条纯声明点的 deprecation，将来提升被正式移除时本包无需改动。
warnings = "-implicit_impl_as_method"
