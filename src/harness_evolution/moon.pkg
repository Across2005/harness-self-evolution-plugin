import {
  "Across2005/harness-self-evolution/mcp",
  "Across2005/harness-self-evolution/scanner",
  "Across2005/harness-self-evolution/store",
  "Across2005/harness-self-evolution/types",
  "Across2005/harness-self-evolution/util",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

// main 包不放任何 `_test.mbt`：工具链明确警告
// "Main packages will stop generating blackbox tests in a future release.
//  Move public behavior into a non-main package"（Phase 0 门禁实测）。
// 全部测试都在各自被测的非 main 包里，本包只负责装配与启动。
pkgtype(kind: "executable")
