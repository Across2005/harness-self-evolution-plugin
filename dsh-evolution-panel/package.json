{
  "name": "dsh-evolution-panel",
  "version": "0.1.0",
  "description": "Read-only DSH Web floating panel for harness-self-evolution runtime: pipeline overview, live DAG timeline, honest metric gaps",
  "type": "module",
  "main": "./lib/evolution-panel.js",
  "types": "./lib/evolution-panel.d.ts",
  "scripts": {
    "prebuild": "node scripts/clean-lib.mjs",
    "build": "tsc -p tsconfig.json && tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/evolution-panel.d.ts",
      "default": "./lib/evolution-panel.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.d.ts",
    "lib/client/**/*.d.ts",
    "cordis.yml",
    "cordis.patch.yml",
    "dshx.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "harness-self-evolution",
    "observability",
    "plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.1.6 || >=0.1.6-alpha.1 <0.2.0"
  },
  "overrides": {
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-cordis": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-deque": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-cordis": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "@deepseek-ai/dsh-deque": "0.1.5-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
